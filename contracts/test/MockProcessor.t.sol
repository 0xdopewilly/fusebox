pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {FuseFixtures} from "./fixtures/FuseFixtures.sol";
import {MockFactory, MockProcessor} from "./mocks/MockTapeout.sol";

/// @notice The Solidity mock evaluates the shipped netlists exactly like the TypeScript simulator
///         (vectors generated by circuits/scripts/build.ts), and its circuitInfo matches the build.
contract MockProcessorTest is Test {
    MockProcessor internal p;

    function setUp() public {
        p = new MockProcessor(address(new MockFactory()));
    }

    function test_fixtures_match_typescript_simulator() public {
        for (uint256 k; k < FuseFixtures.COUNT; ++k) {
            FuseFixtures.Fixture memory f = FuseFixtures.fixture(k);
            assertEq(keccak256(f.netlist), f.netlistHash, "TS keccak == Solidity keccak");
            uint256 id = p.tapeout(f.netlist, f.nIn, f.nOut);
            (uint32 nIn, uint32 nOut, uint32 nState, uint32 gates) = p.circuitInfo(id);
            assertEq(nIn, f.nIn);
            assertEq(nOut, f.nOut);
            assertEq(nState, f.nState);
            assertEq(gates, f.gates);
            FuseFixtures.Vector[] memory v = FuseFixtures.vectors(k);
            for (uint256 i; i < v.length; ++i) {
                if (f.nState == 0) {
                    assertEq(p.eval(id, v[i].inputs), v[i].outputs, v[i].note);
                } else {
                    (bytes memory ns, bytes memory out) = p.step(id, v[i].state, v[i].inputs);
                    assertEq(out, v[i].outputs, v[i].note);
                    assertEq(ns, v[i].newState, v[i].note);
                }
            }
        }
    }

    function test_eval_reverts_on_latch() public {
        FuseFixtures.Fixture memory f = FuseFixtures.fixture(FuseFixtures.BREAKER);
        uint256 id = p.tapeout(f.netlist, f.nIn, f.nOut);
        vm.expectRevert(bytes("has latch: use step"));
        p.eval(id, hex"00");
    }

    function test_tapeout_rejects_forward_nand() public {
        vm.expectRevert(bytes("NAND: future signal"));
        p.tapeout(hex"0000000200000500000002000003", 2, 1);
    }
}

{
  "name": "fusebox-tools",
  "version": "0.1.0",
  "description": "Fusebox for agent frameworks: ready-made tools for the Vercel AI SDK, LangChain and ElizaOS (plus a framework-free core) to check, pay and pay per call (x402) through a Fusebox wallet whose TapeOut circuit fuses decide every payment on X Layer.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js"
    },
    "./langchain": {
      "types": "./dist/langchain.d.ts",
      "import": "./dist/langchain.js"
    },
    "./eliza": {
      "types": "./dist/eliza.d.ts",
      "import": "./dist/eliza.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xdopewilly/fusebox.git",
    "directory": "tools"
  },
  "homepage": "https://fusebox-xlayer.vercel.app/docs",
  "keywords": [
    "x-layer",
    "tapeout",
    "ai-agents",
    "agent-wallet",
    "payments",
    "x402",
    "fusebox",
    "vercel-ai-sdk",
    "langchain",
    "elizaos",
    "eliza-plugin"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "fusebox-sdk": "^0.3.0"
  },
  "peerDependencies": {
    "viem": "^2.30.0",
    "zod": "^3.25.0 || ^4.0.0",
    "ai": ">=5.0.0",
    "@langchain/core": ">=0.3.0",
    "@elizaos/core": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@elizaos/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@elizaos/core": "1.7.2",
    "@langchain/core": "1.4.1",
    "@types/node": "24.19.2",
    "ai": "7.0.173",
    "typescript": "5.9.3",
    "viem": "2.57.12",
    "zod": "4.6.7"
  }
}
